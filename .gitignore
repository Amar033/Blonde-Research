*.py[cod]
*$py.class
*.so
.build/
build/
dist/
.eggs/
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/
.cache/
.ipynb_checkpoints/
.venv/
venv/
.python-version
pip-wheel-metadata/

# Python env files
.env
.env.*
*.env
backend/.env
backend/.env.*

# --- Node/Next.js ---
node_modules/
.npm/
.pnpm-store/
.pnpm-debug.log*
.npm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
out/
.vercel/
.turbo/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.vercel/
frontend/.env
frontend/.env.*

# --- Logs ---
logs/
*.log
*.pid
*.pid.lock

# --- Docker ---
.docker/
docker/*.pid
docker/*.log
docker/.env
docker-compose.override.yml

# --- Editors/OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Coverage reports ---
coverage/

# --- Project temp/data ---
tmp/
.data/
data/
